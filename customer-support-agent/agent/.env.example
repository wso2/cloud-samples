# Copy to .env for a local run. Never commit .env.

# The products MCP endpoint: the MCP gateway URL plus /mcp in the cloud, or the local server.
PRODUCTS_MCP_URL=http://localhost:9090/mcp
# The MCP gateway's API key (PRODUCTS_MCP_API_KEY also works). Leave empty for the local server.
MCP_API_KEY=

# In Agent Management, keep USE_LLM_PROVIDER=true and bind an Anthropic, OpenAI, Gemini or Mistral LLM provider
# with the configuration name LLM_PROVIDER, which injects LLM_PROVIDER_URL, LLM_PROVIDER_API_KEY and
# LLM_PROVIDER_PROVIDER. Local runs call Anthropic directly.
USE_LLM_PROVIDER=false
ANTHROPIC_API_KEY=
# Each provider has a default model; set MODEL to use another.
MODEL=claude-sonnet-5-5
MAX_TOKENS=16000
STORE_NAME=Summit Outdoor
